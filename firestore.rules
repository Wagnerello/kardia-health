rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função para verificar se o usuário é admin via Custom Claims
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Função para verificar se a requisição é do dono do recurso
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Validação de Schema para Pressão Arterial
    function isValidBpReading() {
      let data = request.resource.data;
      return data.sistolica is number && data.sistolica >= 40 && data.sistolica <= 300
          && data.diastolica is number && data.diastolica >= 30 && data.diastolica <= 200
          && (!('pulso' in data) || (data.pulso is number && data.pulso >= 30 && data.pulso <= 250));
    }

    // Validação de Schema para Glicemia
    function isValidGlicemia() {
      let data = request.resource.data;
      return data.valor is number && data.valor >= 20 && data.valor <= 1000;
    }

    // Validação de Schema para Hidratação
    function isValidWaterLog() {
      let data = request.resource.data;
      return data.amount_ml is number && data.amount_ml >= 0 && data.amount_ml <= 10000;
    }

    // Validação de Schema para Histórico de Peso
    function isValidWeight() {
      let data = request.resource.data;
      return data.peso is number && data.peso >= 20 && data.peso <= 500;
    }

    // Validação de Schema para Medicações
    function isValidMedication() {
      let data = request.resource.data;
      return data.nome is string && data.nome.size() > 0 && data.nome.size() <= 200;
    }

    // Usuários podem ler e escrever seus próprios documentos
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) && request.resource.data.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Aferições de pressão
    match /bp_readings/{readingId} {
      allow read, delete: if isOwner(resource.data.user_id) || isAdmin();
      allow create: if isOwner(request.resource.data.user_id) && isValidBpReading();
      allow update: if (isOwner(resource.data.user_id) || isAdmin()) 
                    && isOwner(request.resource.data.user_id) 
                    && isValidBpReading();
    }

    // Registros de Água
    match /water_logs/{logId} {
      allow read, delete: if isOwner(resource.data.user_id) || isAdmin();
      allow create: if isOwner(request.resource.data.user_id) && isValidWaterLog();
      allow update: if (isOwner(resource.data.user_id) || isAdmin()) 
                    && isOwner(request.resource.data.user_id) 
                    && isValidWaterLog();
    }

    // Aferições de glicemia
    match /glicemia_readings/{readingId} {
      allow read, delete: if isOwner(resource.data.user_id) || isAdmin();
      allow create: if isOwner(request.resource.data.user_id) && isValidGlicemia();
      allow update: if (isOwner(resource.data.user_id) || isAdmin()) 
                    && isOwner(request.resource.data.user_id) 
                    && isValidGlicemia();
    }

    // Medicações e Suplementos
    match /user_medications/{medId} {
      allow read, delete: if isOwner(resource.data.user_id) || isAdmin();
      allow create: if isOwner(request.resource.data.user_id) && isValidMedication();
      allow update: if (isOwner(resource.data.user_id) || isAdmin()) 
                    && isOwner(request.resource.data.user_id) 
                    && isValidMedication();
    }

    // Laudos
    match /laudos/{laudoId} {
      allow read, delete: if isOwner(resource.data.user_id) || isAdmin();
      allow create, update: if isOwner(request.resource.data.user_id) || isAdmin();
    }

    // Histórico de peso
    match /weight_history/{weightId} {
      allow read, delete: if isOwner(resource.data.user_id) || isAdmin();
      allow create: if isOwner(request.resource.data.user_id) && isValidWeight();
      allow update: if (isOwner(resource.data.user_id) || isAdmin()) 
                    && isOwner(request.resource.data.user_id) 
                    && isValidWeight();
    }

    // Análises diárias da IA
    match /analises_diarias/{analiseId} {
      allow read, delete: if isOwner(resource.data.user_id) || isAdmin();
      allow create, update: if isOwner(request.resource.data.user_id) || isAdmin();
    }

    // Logs de atividade do Admin
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Configurações globais do sistema
    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}