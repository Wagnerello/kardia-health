# ==========================================
# Variáveis de Ambiente — KardIA (Pressly)
# Copie este arquivo para .env ou .env.local e preencha com suas chaves reais
# ==========================================

# Configuração do Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Provedores de Inteligência Artificial & OCR
# Google Gemini API (https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=

# Groq API (Opcional - alta velocidade para inferência)
VITE_GROQ_API_KEY=

# Google Cloud Vision API (OCR para medidores)
VITE_GOOGLE_VISION_API_KEY=

# OpenAI API (Alternativa)
VITE_OPENAI_API_KEY=
