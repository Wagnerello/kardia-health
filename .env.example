# Variáveis de Ambiente — PressãoApp
# Copie este arquivo para .env e preencha as chaves

# Google Cloud Vision API (OCR para leitura do medidor)
# Obtenha em: https://console.cloud.google.com/apis/library/vision.googleapis.com
VITE_GOOGLE_VISION_API_KEY=

# Google Gemini API (Feedback de IA — recomendado, gratuito)
# Obtenha em: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# OpenAI API (alternativa ao Gemini)
# Obtenha em: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=
